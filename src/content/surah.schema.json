{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mahirul Qur'an Surah",
  "type": "object",
  "required": ["number", "nameArabic", "nameEnglish", "meaningEnglish", "ayahs"],
  "properties": {
    "$schema": { "type": "string" },
    "number": { "type": "integer", "minimum": 1, "maximum": 114 },
    "nameArabic": { "type": "string", "minLength": 1 },
    "nameEnglish": { "type": "string", "minLength": 1 },
    "meaningEnglish": { "type": "string", "minLength": 1 },
    "ayahs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["verseKey", "surahNumber", "ayahNumber", "textQpcHafs"],
        "properties": {
          "verseKey": { "type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}$" },
          "surahNumber": { "type": "integer", "minimum": 1, "maximum": 114 },
          "ayahNumber": { "type": "integer", "minimum": 1 },
          "textQpcHafs": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
