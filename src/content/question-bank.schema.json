{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mahirul Qur'an Question Bank",
  "type": "array",
  "items": {
    "oneOf": [
      { "$ref": "#/$defs/chooseNext" },
      { "$ref": "#/$defs/identifySurah" },
      { "$ref": "#/$defs/arrangeAyahs" },
      { "$ref": "#/$defs/reciteNext" }
    ]
  },
  "$defs": {
    "verseKey": { "type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}$" },
    "base": {
      "type": "object",
      "required": ["id", "type", "enabled", "surahNumbers", "difficulty", "source", "data"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "enabled": { "type": "boolean" },
        "surahNumbers": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 114 } },
        "difficulty": { "enum": [1, 2, 3] },
        "source": { "enum": ["generated", "curated"] },
        "note": { "type": "string" }
      }
    },
    "chooseNext": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "choose-next-ayah" }, "data": { "type": "object", "required": ["promptAyahKey", "correctAyahKey"], "properties": { "promptAyahKey": { "$ref": "#/$defs/verseKey" }, "correctAyahKey": { "$ref": "#/$defs/verseKey" }, "distractorAyahKeys": { "type": "array", "items": { "$ref": "#/$defs/verseKey" } } }, "additionalProperties": false } } }
      ]
    },
    "identifySurah": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "identify-surah" }, "data": { "type": "object", "required": ["ayahKey", "correctSurahNumber"], "properties": { "ayahKey": { "$ref": "#/$defs/verseKey" }, "correctSurahNumber": { "type": "integer", "minimum": 1, "maximum": 114 } }, "additionalProperties": false } } }
      ]
    },
    "arrangeAyahs": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "arrange-ayahs" }, "data": { "type": "object", "required": ["correctOrder"], "properties": { "correctOrder": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "$ref": "#/$defs/verseKey" } } }, "additionalProperties": false } } }
      ]
    },
    "reciteNext": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "recite-next" }, "data": { "type": "object", "required": ["promptAyahKey", "answerAyahKey"], "properties": { "promptAyahKey": { "$ref": "#/$defs/verseKey" }, "answerAyahKey": { "$ref": "#/$defs/verseKey" } }, "additionalProperties": false } } }
      ]
    }
  }
}
